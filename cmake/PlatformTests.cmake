if(BUILD_TESTING)
    if(WIN32)
        ds_test(platform.windows_walk tests/platform/test_windows_walk.c ${ds_manifest})
        ds_test(platform.windows_metadata tests/platform/test_windows_metadata.c ${ds_manifest})
        foreach(test test_platform_windows_walk test_platform_windows_metadata)
            target_link_libraries(${test} PRIVATE ds_platform)
            target_include_directories(${test} PRIVATE src/platform/windows)
        endforeach()
    else()
        ds_test(platform.linux_walk tests/platform/test_linux_walk.c)
        ds_test(platform.linux_mounts tests/platform/test_linux_mounts.c)
        foreach(test test_platform_linux_walk test_platform_linux_mounts)
            target_link_libraries(${test} PRIVATE ds_platform)
            target_include_directories(${test} PRIVATE src/platform/linux)
        endforeach()
        target_link_options(test_platform_linux_walk PRIVATE
            -Wl,--wrap=readdir -Wl,--wrap=linux_open_directory -Wl,--wrap=linux_metadata_at)
        add_test(NAME platform.linux_bind COMMAND test_platform_linux_mounts --bind)
        set_tests_properties(platform.linux_bind PROPERTIES SKIP_RETURN_CODE 77)
    endif()
endif()
